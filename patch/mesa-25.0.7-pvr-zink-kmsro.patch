+/* Emulate transform feedback on drivers without VK_EXT_transform_feedback.
+ *
+ * The captured outputs are stored to the feedback buffer, whose device address
+ * arrives in a push constant. Each output goes to
+ *     base + vertex_index * stride + offset
+ * which is exactly the layout the frontend asked for, and indexing by vertex
+ * keeps the capture order deterministic without needing atomics.
+ *
+ * Runs at the end of the entrypoint so it reads the final value of each output.
+ */
+static bool
+lower_xfb_to_stores(nir_shader *shader)
+{
+   if (!shader->xfb_info || !shader->xfb_info->output_count)
+      return false;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+   nir_builder b = nir_builder_create(impl);
+   b.cursor = nir_after_cf_list(&impl->body);
+
+   nir_def *lo = nir_load_push_constant_zink(&b, 1, 32,
+                     nir_imm_int(&b, ZINK_GFX_PUSHCONST_XFB_ADDR_LO));
+   nir_def *hi = nir_load_push_constant_zink(&b, 1, 32,
+                     nir_imm_int(&b, ZINK_GFX_PUSHCONST_XFB_ADDR_HI));
+   nir_def *base = nir_ior(&b, nir_u2u64(&b, lo),
+                           nir_ishl(&b, nir_u2u64(&b, hi), nir_imm_int(&b, 32)));
+   nir_def *vid = nir_u2u64(&b, nir_load_vertex_id(&b));
+
+   bool progress = false;
+   for (unsigned i = 0; i < shader->xfb_info->output_count; i++) {
+      const nir_xfb_output_info *out = &shader->xfb_info->outputs[i];
+      unsigned stride = shader->xfb_info->buffers[out->buffer].stride;
+      nir_variable *var = nir_find_variable_with_location(shader, nir_var_shader_out,
+                                                          out->location);
+      if (!var)
+         continue;
+
+      /* The varying may be scalarised, so each captured component can live in
+       * its own variable at its own location_frac - which is exactly what
+       * find_var_with_location_frac resolves. */
+      unsigned n = util_bitcount(out->component_mask);
+      nir_def *comps[4];
+      unsigned idx = 0;
+      for (unsigned c = 0; c < 4 && idx < n; c++) {
+         if (!(out->component_mask & (1u << c)))
+            continue;
+         unsigned comp = out->component_offset + c;
+         nir_variable *cv = find_var_with_location_frac(shader, out->location, comp, false,
+                                                        nir_var_shader_out);
+         if (!cv)
+            continue;
+         nir_def *v = nir_load_var(&b, cv);
+         unsigned sub = comp - cv->data.location_frac;
+         comps[idx++] = v->num_components > 1 ? nir_channel(&b, v, sub) : v;
+      }
+      if (!idx)
+         continue;
+
+      nir_def *packed = nir_vec(&b, comps, idx);
+      nir_def *off = nir_iadd_imm(&b, nir_imul_imm(&b, vid, stride), out->offset);
+      nir_store_global(&b, nir_iadd(&b, base, off), 4, packed, (1u << idx) - 1);
+      progress = true;
+   }
+   return progress;
+}
