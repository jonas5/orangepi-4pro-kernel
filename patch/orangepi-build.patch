+# Inject the Allwinner BSP driver tree (drivers/, platform/, include/, Kconfig)
+# into the kernel source at config time.  The tree contains prebuilt binary
+# archives, so it cannot be shipped as a regular patch; it is fetched and copied
+# in instead.  Requires BSP_TOP to be exported for the Kconfig preprocessor.
+ALLWINNER_BSP_SOURCE="https://github.com/alexcaoys/allwinner-bsp.git"
+ALLWINNER_BSP_BRANCH="branch:linux-6.18.y"
+
+custom_kernel_config()
+{
+	[[ $BRANCH == next && $LINUXFAMILY == sun60iw2 ]] || return 0
+
+	local bspdir="${EXTER}/cache/sources/allwinner-bsp"
+	# fetch_from_repo() cd's into the fetched directory; remember where we are.
+	local kerneldir_orig="$(pwd)"
+
+	if [[ $IGNORE_UPDATES != yes ]]; then
+		fetch_from_repo "$ALLWINNER_BSP_SOURCE" "$bspdir" "$ALLWINNER_BSP_BRANCH" "no"
+	fi
+
+	cd "$kerneldir_orig" || exit
+
+	if [[ ! -f "$bspdir/Kconfig" ]]; then
+		exit_with_error "Allwinner BSP source not found" "$bspdir"
+	fi
+
+	display_alert "Injecting Allwinner BSP driver tree" "$ALLWINNER_BSP_BRANCH" "info"
+
+	rm -rf bsp
+	mkdir -p bsp
+	rsync -a --exclude='.git' "$bspdir"/ bsp/
+
+	# The BSP repo does not ship sunxi-autogen.h (it is listed in .gitignore and
+	# is normally generated during the BSP's own build).  bsp/drivers/clk/sunxi-ng
+	# includes it for AW_BSP_VERSION, so create it explicitly.
+	mkdir -p bsp/include
+	printf '#define AW_BSP_VERSION "allwinner-bsp %s"\n' \
+		"$(git -C "$bspdir" rev-parse --short HEAD 2>/dev/null || echo unknown)" > bsp/include/sunxi-autogen.h
+
+	# Apply fix-up patches that adapt the BSP snapshot to 6.18.y kernel APIs.
+	# These cannot live in KERNELPATCHDIR (sun60iw2-next): advanced_patch() runs
+	# before this hook installs the BSP tree, so its changes would be wiped by
+	# the rsync above.
+	for fixup in "${EXTER}"/patch/kernel/sun60iw2-next-bsp/*.patch; do
+		[[ -f $fixup ]] || continue
+		display_alert "Applying BSP fixup" "$(basename "$fixup")" "info"
+		patch -p1 --batch --forward < "$fixup" || \
+			exit_with_error "BSP fixup patch failed" "$(basename "$fixup")"
+	done
+
+	# The BSP Kconfig files reference $(BSP_TOP); export an absolute path so the
+	# kconfig preprocessor can resolve it for olddefconfig/menuconfig.
+	export BSP_TOP="$(pwd)/bsp/"
+}
