# Never install generic Debian or Ubuntu mainline/generic/RT kernels on Orange Pi 4 Pro
Package: linux-image-* linux-headers-*
Pin: release o=Debian*
Pin-Priority: -1

Package: linux-image-* linux-headers-*
Pin: release o=Ubuntu*
Pin-Priority: -1

# Allow custom Orange Pi vendor packages
Package: *sun60iw2*
Pin: release *
Pin-Priority: 1000
