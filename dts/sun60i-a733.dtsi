			compatible = "allwinner,sun60i-a733-usb-phy",
				     "allwinner,sun8i-h3-usb-phy";
			reg = <0x04100400 0x400>;
			clocks = <&osc24M>;
			clock-names = "usb_ref";
			resets = <&ccu RST_USB0>;
			reset-names = "usb0_reset";
			#phy-cells = <1>;
			status = "okay";
		};

		ehci: ehci@4101000 {
			compatible = "allwinner,sun60i-a733-ehci",
				     "allwinner,sun8i-h3-ehci";
			reg = <0x04101000 0xfff>,
			      <0x00000000 0x100>,
			      <0x04100000 0x1000>;
			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_USB0_EHCI>;
			resets = <&ccu RST_USB0_EHCI>;
			phys = <&usbphy 1>;
			phy-names = "usb";
			status = "disabled";
		};

		ohci: ohci@4101400 {
			compatible = "allwinner,sun60i-a733-ohci",
				     "allwinner,sun8i-h3-ohci";
			reg = <0x04101400 0xfff>,
			      <0x00000000 0x100>,
			      <0x04100000 0x1000>;
			interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_USB0_OHCI>;
			resets = <&ccu RST_USB0_OHCI>;
			phys = <&usbphy 1>;
			phy-names = "usb";
			status = "disabled";
		};

		ehci1: ehci@4200000 {
			compatible = "allwinner,sun60i-a733-ehci",
				     "allwinner,sun8i-h3-ehci";
			reg = <0x04200000 0xfff>,
			      <0x00000000 0x100>,
			      <0x04100000 0x1000>;
			interrupts = <GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_USB1_EHCI>;
			resets = <&ccu RST_USB1_EHCI>;
			phys = <&usbphy 2>;
			phy-names = "usb";
			status = "disabled";
		};

		ohci1: ohci@4200400 {
			compatible = "allwinner,sun60i-a733-ohci",
				     "allwinner,sun8i-h3-ohci";
			reg = <0x04200400 0xfff>,
			      <0x00000000 0x100>,
			      <0x04100000 0x1000>;
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_USB1_OHCI>;
			resets = <&ccu RST_USB1_OHCI>;
			phys = <&usbphy 2>;
			phy-names = "usb";
			status = "disabled";
		};

		dwc3: dwc3@6a00000 {
			compatible = "snps,dwc3";
			reg = <0x06a00000 0x100000>;
			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_USB2_MF>;
			clock-names = "bus_clk";
			resets = <&ccu RST_USB2>;
			reset-names = "dwc3";
			phys = <&usbphy 3>;
			phy-names = "usb3-phy";
			dr_mode = "otg";
		maximum-speed = "super-speed-plus";
			usb-role-switch;
			status = "disabled";
		};

		pcie: pcie@6000000 {
			compatible = "allwinner,sun60i-a733-pcie";
			reg = <0x06000000 0x480000>;
			reg-names = "dbi";
			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "sii", "msi",
					  "edma-w0", "edma-w1",
					  "edma-w2", "edma-w3",
					  "edma-r0", "edma-r1",
					  "edma-r2", "edma-r3";
			clocks = <&ccu CLK_PCIE0_AUX>,
				 <&ccu CLK_PCIE0_AXI_SLV>;
			clock-names = "pclk_aux", "pclk_slv";
			resets = <&ccu RST_BUS_PCIE0>;
			reset-names = "pclk_rst";
			phys = <&serdes0_phy PHY_TYPE_PCIE 0>;
			phy-names = "pcie-phy";
			power-domains = <&pck 1>;
			status = "disabled";
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &gic 0 GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 2 &gic 0 GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 3 &gic 0 GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 4 &gic 0 GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 5 &gic 0 GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 6 &gic 0 GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 7 &gic 0 GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>;
		};

		gmac0: ethernet@4500000 {
			compatible = "allwinner,sun60i-a733-gmac",
				     "allwinner,sun50i-r329-gmac",
				     "snps,dwmac-5.20";
			reg = <0x04500000 0x8000>,
			      <0x04508000 0x1000>;
			reg-names = "mac", "mtl";
			interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&ccu CLK_GMAC0>,
				 <&ccu CLK_GMAC0_MBUS>,
				 <&ccu CLK_GMAC0_PHY>,
				 <&ccu CLK_GMAC_PTP>;
			clock-names = "stmmaceth", "pclk", "phy",
				      "ptp_ref";
			resets = <&ccu RST_BUS_GMAC0_AXI>,
				 <&ccu RST_BUS_GMAC0>;
			reset-names = "stmmaceth", "ahb";
			phy-mode = "rgmii";
			phy-handle = <&ext_gmac0_phy>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		npu: npu@3600000 {
			compatible = "allwinner,sun60i-a733-npu";
			reg = <0x03600000 0x1000>;
			interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_NPU>, <&ccu CLK_PLL_NPU>,
				 <&ccu CLK_BUS_NPU>;
			clock-names = "clk", "clk_parent", "clk_bus";
			resets = <&ccu RST_BUS_NPU>;
			status = "disabled";
		};

		gpu: gpu@1800000 {
			compatible = "allwinner,sun60i-a733-mali",
				     "arm,mali-bifrost";
			reg = <0x01800000 0x8ffff>;
			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gp", "gpmmu", "pp0";
			clocks = <&ccu CLK_PLL_GPU>, <&ccu CLK_GPU>,
				 <&ccu CLK_BUS_GPU>;
			clock-names = "clk_mali", "clk_mali_bus",
				      "clk_bus_mali";
			resets = <&ccu RST_BUS_GPU>;
			operating-points-v2 = <&gpu_opp_table>;
			power-domains = <&pck 2>;
			#cooling-cells = <2>;

			gpu_opp_table: opp-table {
				compatible = "operating-points-v2";
				opp-shared;
			};
		};

		serdes0_phy: phy@6c00000 {
			compatible = "allwinner,sun60i-a733-serdes";
			reg = <0x06c00000 0x10000>;
			clocks = <&ccu CLK_PLL_PERI0_400M>, <&osc24M>;
			clock-names = "refclk", "sysclk";
			resets = <&ccu RST_USB0>;
			#phy-cells = <2>;
			status = "okay";
		};

		nsi: nsi@2020000 {
			compatible = "allwinner,sunxi-nsi-v2";
			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x02020000 0x10000>,
			      <0x0A030000 0x20000>;
			clocks = <&ccu 0>, <&ccu 1>, <&ccu 2>,
				 <&ccu 3>, <&ccu 4>, <&ccu 5>,
				 <&ccu 6>, <&ccu 7>;
			#nsi-cells = <1>;
		};

		dsufreq: dsufreq@8860000 {
			compatible = "allwinner,sun60i-a733-dsufreq";
			reg = <0x08860000 0x1000>;
		};

		cpupll_ccu: cpupll-ccu@8870000 {
			compatible = "allwinner,sun60i-a733-cpupll";
			reg = <0x08870000 0x3034>;
			clocks = <&rtc_ccu 0>;
			clock-names = "dcxo";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		rtc_ccu: rtc-ccu@7090000 {
			compatible = "allwinner,sun60i-a733-rtc-ccu";
			reg = <0x07090000 0x400>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		r_ccu: r-ccu@7010000 {
			compatible = "allwinner,sun60i-a733-r-ccu";
			reg = <0x07010000 0x340>;
			clocks = <&osc24M>,
				 <&rtc_ccu 0>,
				 <&rc_16m>,
				 <&ccu CLK_PLL_PERI0_200M>,
				 <&ccu CLK_PLL_AUDIO0_4X>;
			clock-names = "hosc",
				      "losc",
				      "iosc",
				      "pll-periph",
				      "pll-audio";
			#clock-cells = <1>;
			#reset-cells = <1>;
			assigned-clocks = <&r_ccu CLK_R_AHB>,
					   <&r_ccu CLK_R_APB0>;
			assigned-clock-rates = <200000000>, <100000000>;
		};

		nmi_intc: nmi-intc@7010320 {
			compatible = "allwinner,sun60i-a733-nmi",
				     "allwinner,sun9i-a80-nmi";
			reg = <0x07010320 0xc>;
			interrupts = <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		r_i2c0: i2c@7083000 {
			compatible = "allwinner,sun60i-a733-i2c",
				     "allwinner,sun8i-v536-i2c",
				     "allwinner,sun6i-a31-i2c";
			reg = <0x07083000 0x400>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_R_TWI0>;
			resets = <&r_ccu RST_BUS_R_TWI0>;
			dmas = <&dma 47>, <&dma 47>;
			dma-names = "rx", "tx";
			pinctrl-names = "default";
			pinctrl-0 = <&r_i2c0_pins>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
		};

		rtc: rtc@7090000 {
			compatible = "allwinner,sun60i-a733-rtc",
				     "allwinner,sun6i-a31-rtc";
			reg = <0x07090000 0x320>;
			interrupts = <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_R_AHB>,
				 <&rtc_ccu CLK_RTC_1K>,
				 <&rtc_ccu CLK_RTC_SPI>;
			clock-names = "r-ahb-rtc", "rtc-1k", "rtc-spi";
			resets = <&r_ccu RST_BUS_RTC>;
			#clock-cells = <1>;
			status = "disabled";
		};

		pck: power-controller@7060000 {
			compatible = "allwinner,sun60i-a733-power-controller",
				     "syscon", "simple-mfd";
			reg = <0x07060000 0xb000>;
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			pck_usb: power-domain@0 {
				compatible = "allwinner,sun60i-a733-pd-usb";
				reg = <0>;
				#power-domain-cells = <0>;
				clocks = <&ccu CLK_USB0>,
					 <&ccu CLK_USB1>,
					 <&ccu CLK_USB2>;
				resets = <&ccu RST_USB0>,
					 <&ccu RST_USB1>,
					 <&ccu RST_USB2>;
			};

			pck_de: power-domain@1 {
				compatible = "allwinner,sun60i-a733-pd-de";
				reg = <1>;
				#power-domain-cells = <0>;
				clocks = <&ccu CLK_DE>,
					 <&ccu CLK_BUS_DE>;
				resets = <&ccu RST_BUS_DE>;
			};

			pck_gpu: power-domain@2 {
				compatible = "allwinner,sun60i-a733-pd-gpu";
				reg = <2>;
				#power-domain-cells = <0>;
				clocks = <&ccu CLK_GPU>;
				resets = <&ccu RST_BUS_GPU>;
			};

			pck_pcie: power-domain@3 {
				compatible = "allwinner,sun60i-a733-pd-pcie";
				reg = <3>;
				#power-domain-cells = <0>;
				clocks = <&ccu CLK_PCIE0_AUX>,
					 <&ccu CLK_PCIE0_AXI_SLV>;
				resets = <&ccu RST_BUS_PCIE0>;
			};

			r_ppu0: r-ppu@1000 {
				compatible = "allwinner,sunxi-r-ppu-v1";
				reg = <0x1000>;
				interrupts = <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&r_ccu CLK_R_PPU>;
				clock-names = "r-ppu";
				resets = <&r_ccu RST_BUS_R_PPU0>;
				power-domains = <&pck_pcie>;
			};

			r_ppu1: r-ppu@1400 {
				compatible = "allwinner,sunxi-r-ppu-v1";
				reg = <0x1400>;
				interrupts = <GIC_SPI 197 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&r_ccu CLK_R_PPU>;
				clock-names = "r-ppu";
				resets = <&r_ccu RST_BUS_R_PPU1>;
				#power-domain-cells = <1>;
			};
		};

		sunxi-dram-freq@2020000 {
			compatible = "allwinner,sun60i-a733-dramfreq";
			reg = <0x02020000 0x10000>;
			clocks = <&ccu CLK_PLL_DDR>, <&ccu CLK_PLL_DDR1>;
			clock-names = "pll-ddr0", "pll-ddr1";
			status = "disabled";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};
};
