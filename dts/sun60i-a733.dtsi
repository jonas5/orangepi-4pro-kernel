		hwspinlock: hwspinlock@3005000 {
			compatible = "allwinner,sun60i-a733-hwspinlock";
			reg = <0x03005000 0x1000>;
			clocks = <&ccu CLK_SPINLOCK>;
			clock-names = "clk_hwspinlock_bus";
			resets = <&ccu RST_BUS_SPINLOCK>;
			reset-names = "rst";
			#hwlock-cells = <1>;
		};

		msgbox: mailbox@3004000 {
			compatible = "allwinner,sun60i-a733-msgbox";
			reg = <0x03004000 0x1000>,
			      <0x07094000 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "mbox",
					  "mbox_resp";
			clocks = <&ccu CLK_MSGBOX0>;
			clock-names = "msgbox";
			resets = <&ccu RST_BUS_MSGBOX0>;
			reset-names = "rst";
			#mbox-cells = <1>;
			status = "okay";
		};

		iommu: iommu@3900000 {
			compatible = "allwinner,sun60i-a733-iommu";
			reg = <0x03900000 0x20000>;
			interrupts = <GIC_SPI 170 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "iommu-irq1", "iommu-irq2";
			clocks = <&ccu 0>, <&ccu 1>, <&ccu 2>,
				 <&ccu 3>, <&ccu 4>, <&ccu 5>;
			#iommu-cells = <2>;
			status = "okay";
		};

		ve: ve@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			reg = <0x01c0e000 0x3000>,
			      <0x03000000 0x10>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_VE0>, <&ccu CLK_VE_AHB_GATE>,
				 <&ccu CLK_DEC_MBUS_GATE>,
				 <&ccu CLK_VE_DEC_MBUS>,
				 <&ccu CLK_BUS_VE_DEC>, <&ccu CLK_VE_DEC>;
			clock-names = "pll_ve", "ahb_gate", "mbus_gate",
				      "mbus_ve", "bus_ve", "ve";
			resets = <&ccu RST_BUS_VE_DEC>;
			reset-names = "reset_ve";
		};

		ve2: ve2@1c10000 {
			compatible = "allwinner,sunxi-cedar-ve2";
			reg = <0x01c10000 0x1000>,
			      <0x03000000 0x10>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_VE1>, <&ccu CLK_VE_ENC_AHB_GATE>,
				 <&ccu CLK_MBUS_VE_GATE>,
				 <&ccu CLK_MBUS_VE>,
				 <&ccu CLK_BUS_VE_ENC>, <&ccu CLK_VE_ENC0>;
			clock-names = "pll_ve", "ahb_gate", "mbus_gate",
				      "mbus_ve", "bus_ve", "ve";
			resets = <&ccu RST_BUS_VE_ENC0>;
			reset-names = "reset_ve";
		};

		ce: crypto@4603000 {
			compatible = "allwinner,sun60i-a733-crypto",
				     "allwinner,sun8i-ce";
			reg = <0x04603000 0xa0>,
			      <0x04603800 0xa0>;
			interrupts = <GIC_SPI 168 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 169 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "ciphertext",
					  "plaintext";
			clocks = <&ccu CLK_BUS_CE>, <&ccu CLK_CE>,
				 <&ccu CLK_MBUS_CE>,
				 <&ccu CLK_PLL_PERI0_400M>;
			clock-names = "bus", "ce", "mbus-ce", "clksrc";
			resets = <&ccu RST_BUS_CE>;
