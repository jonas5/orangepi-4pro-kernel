// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
/*
 * Device Tree Source for Allwinner Sun60i A733 SoC
 *
 * Based on vendor BSP sun60iw2p1.dtsi and mainline sun50i conventions.
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/sun60i-a733-ccu.h>
#include <dt-bindings/clock/sun60i-a733-r-ccu.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/sun60i-a733-gpio.h>
#include <dt-bindings/thermal/sun60i-a733-thermal.h>
#include <dt-bindings/phy/phy.h>

/ {
	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	osc24M: osc26M: osc26M-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <26000000>;
		clock-output-names = "osc26M";
	};

	iosc: iosc-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <16000000>;
		clock-accuracy = <300000000>;
		clock-output-names = "iosc";
	};

	rc_16m: rc-16m-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <16000000>;
		clock-accuracy = <300000000>;
		clock-output-names = "rc-16m";
	};

	sys24M: sys24M-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "sys24M";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;
		};

		cpu1: cpu@100 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;
		};

		cpu2: cpu@200 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu3: cpu@300 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu4: cpu@400 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu5: cpu@500 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x0 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <162>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu6: cpu@600 {
			compatible = "arm,cortex-a76";
			device_type = "cpu";
			reg = <0x0 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <625>;
			dynamic-power-coefficient = <300>;
			operating-points-v2 = <&cluster1_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu7: cpu@700 {
			compatible = "arm,cortex-a76";
			device_type = "cpu";
			reg = <0x0 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <625>;
			dynamic-power-coefficient = <300>;
			operating-points-v2 = <&cluster1_opp_table>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_sleep>, <&cluster_sleep>;

			thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
				core4 { cpu = <&cpu4>; };
				core5 { cpu = <&cpu5>; };
			};

			cluster1 {
				core0 { cpu = <&cpu6>; };
				core1 { cpu = <&cpu7>; };
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpu_sleep: cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <46>;
				exit-latency-us = <59>;
				min-residency-us = <3570>;
				local-timer-stop;
			};

			cluster_sleep: cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <47>;
				exit-latency-us = <74>;
				min-residency-us = <5000>;
				local-timer-stop;
			};
		};
	};

	cluster0_opp_table: cluster0-opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		opp-416000000 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-780000000 {
			opp-hz = /bits/ 64 <780000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-1196000000 {
			opp-hz = /bits/ 64 <1196000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <244000>;
		};

		opp-1404000000 {
			opp-hz = /bits/ 64 <1404000000>;
			opp-microvolt = <950000>;
			clock-latency-ns = <244000>;
		};

		opp-1508000000 {
			opp-hz = /bits/ 64 <1508000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <244000>;
		};

		opp-1612000000 {
			opp-hz = /bits/ 64 <1612000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};

		opp-1716000000 {
			opp-hz = /bits/ 64 <1716000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};

		opp-1794000000 {
			opp-hz = /bits/ 64 <1794000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};
	};

	cluster1_opp_table: cluster1-opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		opp-416000000 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-780000000 {
			opp-hz = /bits/ 64 <780000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-1196000000 {
			opp-hz = /bits/ 64 <1196000000>;
			opp-microvolt = <820000>;
			clock-latency-ns = <244000>;
		};

		opp-1404000000 {
			opp-hz = /bits/ 64 <1404000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <244000>;
		};

		opp-1508000000 {
			opp-hz = /bits/ 64 <1508000000>;
			opp-microvolt = <900000>;
			clock-latency-ns = <244000>;
		};

		opp-1612000000 {
			opp-hz = /bits/ 64 <1612000000>;
			opp-microvolt = <950000>;
			clock-latency-ns = <244000>;
		};

		opp-1716000000 {
			opp-hz = /bits/ 64 <1716000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <244000>;
		};

		opp-1794000000 {
			opp-hz = /bits/ 64 <1794000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};

		opp-1898000000 {
			opp-hz = /bits/ 64 <1898000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};

		opp-1950000000 {
			opp-hz = /bits/ 64 <1950000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};

		opp-2002000000 {
			opp-hz = /bits/ 64 <2002000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <244000>;
		};
	};

	thermal-zones {
		cpul-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 3>;
			sustainable-power = <3000>;

			trips {
				cpul_alert: cpul-alert {
					temperature = <55000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpul_crit: cpul-crit {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpul_shutdown {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpul_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpub-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 0>;
			sustainable-power = <4000>;

			trips {
				cpub_alert: cpub-alert {
					temperature = <55000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpub_crit: cpub-crit {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpub_shutdown {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpub_alert>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 4>;
			sustainable-power = <2400>;

			trips {
				gpu_alert: gpu-alert {
					temperature = <60000>;
					hysteresis = <0>;
					type = "passive";
				};

				gpu_crit: gpu-crit {
					temperature = <90000>;
					hysteresis = <0>;
					type = "passive";
				};

				gpu_shutdown {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		npu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 2>;

			trips {
				npu_shutdown {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		ddr-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 1>;

			trips {
				ddr_shutdown {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		skin-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 7>;

			trips {
				skin_shutdown {
					temperature = <50000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		dma-ranges;

		ccu: clock-controller@2002000 {
			compatible = "allwinner,sun60i-a733-ccu";
			reg = <0x02002000 0x2000>;
			clocks = <&osc24M>, <&rtc_ccu 0>, <&rc_16m>;
			clock-names = "hosc", "losc", "iosc";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		sid: sid@3006000 {
			compatible = "allwinner,sun50i-a64-sid";
			reg = <0x03006000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			efuse_key: key@0 {
				reg = <0x00 0x08>;
			};

			efuse_chipid: chipid@200 {
				reg = <0x200 0x10>;
			};

			efuse_rotpk: rotpk@140 {
				reg = <0x140 0x20>;
			};

			efuse_huk: huk@80 {
				reg = <0x80 0x40>;
			};
		};

		sram: sram@3000000 {
			compatible = "allwinner,sram";
			reg = <0x03000000 0x184>;
		};

		syscon: syscon@3000000 {
			compatible = "allwinner,sun60i-a733-system-ctrl",
				     "syscon";
			reg = <0x03000000 0x1000>;
		};

		gic: interrupt-controller@3400000 {
			compatible = "arm,gic-v3";
			reg = <0x03400000 0x10000>,
			      <0x03460000 0x100000>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;

			its: msi-controller@3440000 {
				compatible = "arm,gic-v3-its";
				reg = <0x03440000 0x20000>;
				msi-controller;
				#msi-cells = <1>;
			};
		};

		pio: pinctrl@2000000 {
			compatible = "allwinner,sun60i-a733-pinctrl";
			reg = <0x02000000 0x600>;
			interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu 1>, <&osc24M>, <&rtc_ccu 0>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;

			/* UART0 pins */
			uart0_ph8_pins: uart0-ph8-pins {
				pins = "PH8", "PH9";
				function = "uart0";
			};

			/* UART1 pins */
			uart1_pg6_pins: uart1-pg6-pins {
				pins = "PG6", "PG7";
				function = "uart1";
			};
			uart1_rts_cts_pins: uart1-rts-cts-pins {
				pins = "PG8", "PG9";
				function = "uart1";
			};

			/* I2C0 pins */
			i2c0_pins: i2c0-pins {
				pins = "PB6", "PB7";
				function = "i2c0";
				drive-strength = <40>;
			};

			/* I2C1 pins */
			i2c1_pins: i2c1-pins {
				pins = "PB8", "PB9";
				function = "i2c1";
				drive-strength = <40>;
			};

			/* I2C2 pins */
			i2c2_pins: i2c2-pins {
				pins = "PB10", "PB11";
				function = "i2c2";
				drive-strength = <40>;
			};

			/* I2C5 pins */
			i2c5_pins: i2c5-pins {
				pins = "PJ26", "PJ27";
				function = "i2c5";
				drive-strength = <40>;
			};

			/* I2C7 pins */
			i2c7_pins: i2c7-pins {
				pins = "PJ22", "PJ23";
				function = "i2c7";
				drive-strength = <40>;
			};

			/* I2C9 pins */
			i2c9_pins: i2c9-pins {
				pins = "PE14", "PE15";
				function = "i2c9";
				drive-strength = <40>;
			};

			/* MMC0 pins (SD card) */
			mmc0_pins: mmc0-pins {
				pins = "PF0", "PF1", "PF2", "PF3",
				       "PF4", "PF5";
				function = "mmc0";
				drive-strength = <30>;
				bias-pull-up;
			};

			mmc0_cd_pin: mmc0-cd-pin {
				pins = "PF6";
				function = "gpio";
				drive-strength = <20>;
				bias-pull-up;
			};

			/* MMC1 pins (WiFi SDIO) */
			mmc1_pins: mmc1-pins {
				pins = "PG0", "PG1", "PG2", "PG3",
				       "PG4", "PG5";
				function = "mmc1";
				drive-strength = <30>;
				bias-pull-up;
			};

			/* MMC2 pins (eMMC) */
			mmc2_pins: mmc2-pins {
				pins = "PC0", "PC1", "PC5", "PC6",
				       "PC8", "PC9", "PC10", "PC11",
				       "PC13", "PC14", "PC15", "PC16";
				function = "mmc2";
				drive-strength = <30>;
				bias-pull-up;
			};

			/* SPI0 pins */
			spi0_pc_pins: spi0-pc-pins {
				pins = "PC2", "PC3", "PC4", "PC12";
				function = "spi0";
			};

			/* Ethernet RGMII pins */
			rgmii0_pins: rgmii0-pins {
				pins = "PH0", "PH1", "PH2", "PH3",
				       "PH4", "PH5", "PH6", "PH7",
				       "PH8", "PH9", "PH10", "PH11",
				       "PH12", "PH13", "PH14", "PH15";
				function = "rgmii0";
				drive-strength = <40>;
			};

			/* I2S2 pins */
			i2s2_pins: i2s2-pins {
				pins = "PH3", "PH4", "PH5", "PH6";
				function = "i2s2";
			};

			/* DSI0 pins */
			dsi0_pins: dsi0-pins {
				pins = "PD0", "PD1", "PD2", "PD3",
				       "PD4", "PD5", "PD6", "PD7",
				       "PD8", "PD9";
				function = "dsi0";
				drive-strength = <30>;
			};

			/* HDMI pins */
			hdmi_pins: hdmi-pins {
				pins = "PH0", "PH1", "PH2", "PH3",
				       "PH4", "PH5", "PH6", "PH7";
				function = "hdmi";
			};
		};

		r_pio: pinctrl@7025000 {
			compatible = "allwinner,sun60i-a733-r-pinctrl";
			reg = <0x07025000 0x410>;
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu 0>, <&osc24M>, <&rtc_ccu 0>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		wdt: watchdog@2050000 {
			compatible = "allwinner,sun60i-a733-wdt",
				     "allwinner,sun20i-wdt";
			reg = <0x02050000 0x20>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&osc24M>;
		};

		ths: thermal-sensor@2522000 {
			compatible = "allwinner,sun60i-a733-ths";
			reg = <0x02522000 0x500>;
			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_THS>, <&ccu CLK_GPADC0_24M>;
			clock-names = "bus", "gpadc";
			resets = <&ccu RST_BUS_THS>;
			#thermal-sensor-cells = <1>;
		};

		timer0: timer@3009000 {
			compatible = "allwinner,sun50i-timer";
			reg = <0x03009000 0x400>;
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sys24M>, <&ccu CLK_BUS_TIMER>,
				 <&ccu CLK_TIMER0>, <&ccu CLK_TIMER1>;
			clock-names = "parent", "bus",
				      "timer0-mod", "timer1-mod";
			resets = <&ccu RST_BUS_TIMER0>;
		};

	gpufreq: gpu-freq@1800000 {
		compatible = "allwinner,sun60i-a733-gpufreq";
		reg = <0x01800000 0x8ffff>;
		#freq-domain-cells = <0>;
		status = "disabled";
	};

		ledc: led-controller@2520000 {
			compatible = "allwinner,sun60i-a733-ledc",
				     "allwinner,sun50i-a100-ledc";
			reg = <0x02520000 0x400>;
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_LEDC>, <&ccu CLK_BUS_LEDC>;
			clock-names = "mod", "bus";
			resets = <&ccu RST_BUS_LEDC>;
			dmas = <&dma 46>;
			dma-names = "tx";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gpadc: gpadc@2521000 {
			compatible = "allwinner,sun60i-a733-gpadc",
				     "allwinner,sun6i-a31-gpadc";
			reg = <0x02521000 0x400>;
			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_GPADC0>, <&ccu CLK_GPADC0_24M>;
			clock-names = "bus", "hosc";
			resets = <&ccu RST_BUS_GPADC0>;
			status = "disabled";
		};

		lradc: lradc@2524000 {
			compatible = "allwinner,sun60i-a733-lradc",
				     "allwinner,sun20i-lradc";
			reg = <0x02524000 0x100>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_LRADC>;
			resets = <&ccu RST_BUS_LRADC>;
			status = "disabled";
		};

		pwm: pwm@2527000 {
			compatible = "allwinner,sun60i-a733-pwm",
				     "allwinner,sun50i-a64-pwm";
			reg = <0x02527000 0x400>;
			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PWM0>;
			resets = <&ccu RST_BUS_PWM0>;
			status = "disabled";
			#pwm-cells = <3>;
