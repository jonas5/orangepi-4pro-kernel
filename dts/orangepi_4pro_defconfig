#
# Orange Pi 4 Pro - Allwinner A733 (sun60i) minimal bootable config
# Based on arch/arm64/configs/defconfig, trimmed to sun60i essentials.
#
# NOTE: verified symbol names in this tree:
#   - A733 CCU        : CONFIG_SUN60I_CCU (under CONFIG_SUNXI_CCU)
#   - A733 pinctrl    : CONFIG_AW_PINCTRL_SUN60IW2 (selects PINCTRL_SUNXI)
#   - A733 audio      : CONFIG_SND_SUN60I_SOC
#   - A733 GMAC       : CONFIG_SUN60I_GMAC
#   - SD/MMC          : CONFIG_MMC_SUNXI (no MMC_SUN20I_D1 in tree)
#   - Motorcomm PHY   : CONFIG_MOTORCOMM_PHY (not PHY_MOTORCOMM)
#   - No PHY_SUN60I_SERDES exists; only USB3 and PCIE PHYs.
#   - ARCH_SUN60IW2 does not exist; ARCH_SUNXI covers it.
#
# Deliberately excluded (do not compile / BSP-only):
#   - CONFIG_DRM_SUN60I            (DRM API incompatibilities)
#   - CONFIG_CRYPTO_DEV_SUN60I_CE  (missing header)
#   - CONFIG_SUN60I_THERMAL        (thermal API changed)
#   - CONFIG_SND_SOC_AW_SUN60IW2_* (BSP-only DAI/DMA/PCM/SNDWIRE)
#

# ---------- Core kernel ----------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BPF_SYSCALL=y
CONFIG_PREEMPT=y
CONFIG_IRQ_TIME_ACCOUNTING=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=19
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_USER_NS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PROFILING=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---------- Architecture / platform ----------
CONFIG_ARCH_SUNXI=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_JUMP_LABEL=y

# ---------- Kernel image ----------
CONFIG_DEFAULT_HOSTNAME="(none)"
# NOTE: no HAVE_KERNEL_GZIP on this arm64 tree; kernel compression
# mode choice is not available, so no CONFIG_KERNEL_GZIP here.
# CONFIG_COMPAT_BRK is not set

# ---------- Memory ----------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_KSM=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32

# ---------- Networking ----------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IPV6=y
CONFIG_SYN_COOKIES=y
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m

# ---------- Ethernet: sun60i GMAC ----------
# NOTE: SUN60I_GMAC lives inside "if STMMAC_PLATFORM" within "if STMMAC_ETH",
# so both parents must be enabled for it to be visible.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_SUN60I_GMAC=y
CONFIG_PHYLIB=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_FIXED_PHY=y

# ---------- MMC / SD (rootfs device) ----------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SUNXI=y

# ---------- Wireless (modules) ----------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m

# ---------- Firmware / devtmpfs ----------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_ARM_SCMI_PROTOCOL=y

# ---------- Serial console (DesignWare 8250) ----------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_DEV_BUS=y

# ---------- GPIO / pinctrl ----------
CONFIG_AW_PINCTRL_SUN60IW2=y

# ---------- Clocks / reset / timers ----------
CONFIG_COMMON_CLK=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN60I_CCU=y

# ---------- I2C (AXP8191 PMIC bus) ----------
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MV64XXX=y

# ---------- SPI ----------
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_SPI_SPIDEV=m

# ---------- MFD / regulators (AXP8191 PMIC) ----------
CONFIG_MFD_AXP8191=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_AXP8191=y

# ---------- Power / reset ----------
CONFIG_POWER_RESET_SYSCON=y
CONFIG_SYSCON_REBOOT_MODE=y

# ---------- Watchdog ----------
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y

# ---------- RTC ----------
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y

# ---------- DMA engine ----------
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y

# ---------- NVMEM ----------
CONFIG_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y

# ---------- PHYs ----------
CONFIG_GENERIC_PHY=y
CONFIG_PHY_SUN60I_USB3=y
CONFIG_PHY_SUN60I_PCIE=y

# ---------- USB ----------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_NOP_USB_XCEIV=y

# ---------- SCSI (USB storage / sd) ----------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---------- PCI host ----------
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# ---------- Input ----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# ---------- Thermal framework (no sun60i sensor driver) ----------
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
# CONFIG_SUN60I_THERMAL is not set

# ---------- Sound (sun60i ASoC) ----------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_JACK=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN60I_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
# BSP-only drivers not present in mainline:
# CONFIG_SND_SOC_AW_SUN60IW2_DAI is not set
# CONFIG_SND_SOC_AW_SUN60IW2_DMA is not set
# CONFIG_SND_SOC_AW_SUN60IW2_PCM is not set
# CONFIG_SND_SOC_AW_SUN60IW2_SNDWIRE is not set

# ---------- Graphics (disabled: DRM_SUN60I does not compile) ----------
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_DRM_SUN60I is not set

# ---------- Crypto (standard only, no sun60i CE) ----------
CONFIG_CRYPTO=y
# CONFIG_CRYPTO_DEV_SUN60I_CE is not set

# ---------- Filesystems ----------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---------- Security ----------
CONFIG_SECURITY=y
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# ---------- Logging / debug ----------
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=19
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=8
CONFIG_CONSOLE_LOGLEVEL_QUIET=8
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_DEBUG_KERNEL=y
CONFIG_INITCALL_DEBUG=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_DEBUG_DRIVER=y
CONFIG_DEBUG_DEVRES=y
CONFIG_MAGIC_SYSRQ=y
